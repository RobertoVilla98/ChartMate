{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ChartMate",
  "version": "0.2.0",
  "identifier": "com.chartmate.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ChartMate — Scientific Studio",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Roberto Villa",
    "category": "Education",
    "shortDescription": "Scientific visualization & building physics studio",
    "longDescription": "Desktop studio for publication-ready figures, building physics diagnostics (carpet plots, EN 16798-1 / ASHRAE 55 adaptive comfort, duration curves, ASHRAE Guideline 14 calibration) and LaTeX tables.",
    "homepage": "https://github.com/RobertoVilla98/ChartMate",
    "copyright": "Copyright (c) 2026 Roberto Villa",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
